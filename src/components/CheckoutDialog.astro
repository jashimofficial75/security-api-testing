---
/**
 * The checkout dialog a Buy button opens (docs/agent/payments.md): how to pay (when there are
 * several ways), then the provider's form, its popup, or the payment window. Filled in by
 * `src/lib/buy-button.ts`; one per `<BuyButton>`, one per `<PriceList>`.
 */
interface Props {
  id: string;
}
const {id} = Astro.props;
---

<dialog class="checkout" id={`${id}-dialog`} aria-labelledby={`${id}-title`}>
  <h2 class="checkout-title" id={`${id}-title`}>Checkout</h2>
  <p class="checkout-test" data-checkout-test hidden>Test payment: no real money is taken.</p>
  <div class="checkout-form" data-checkout-mount></div>
  <p class="buy-status" data-checkout-status role="status" aria-live="polite"></p>
  <div class="checkout-actions">
    <button type="button" class="button" data-checkout-pay data-label="Pay now" disabled>Pay now</button>
    <button type="button" class="button ghost" data-checkout-reopen hidden>Reopen the payment window</button>
    <button type="button" class="button ghost" data-checkout-close>Cancel</button>
  </div>
</dialog>

<style>
  .buy-status {
    margin: 0;
    min-height: 1.5em;
    color: var(--muted);
    font-size: 0.925rem;
  }
  .buy-status[data-tone='error'] {
    color: var(--danger, currentColor);
  }
  .checkout {
    width: min(32rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    padding: 1.5rem;
    border: 1px solid var(--line, currentColor);
    border-radius: var(--radius);
    background: var(--bg, Canvas);
    color: var(--ink);
  }
  .checkout::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  .checkout-title {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }
  .checkout-test {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.925rem;
  }
  .checkout-form {
    margin-bottom: 0.75rem;
  }
  .checkout-form:empty {
    display: none;
  }
  .checkout-form :global(.checkout-ways) {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .checkout-form :global(.checkout-ways legend) {
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .checkout-form :global(.checkout-way) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line, currentColor);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .checkout-form :global(.checkout-way:has(input:checked)) {
    border-color: var(--accent, currentColor);
  }
  .button[aria-busy='true'] {
    cursor: progress;
  }
  .button:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }
  .checkout-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
</style>
