---
/**
 * <head>, header and footer for every page. The stylesheet is inlined
 * (astro.config.mjs), so nothing blocks the first paint. Scripts are deferred
 * modules from this host: Astro's prefetch and client navigation
 * (`<ClientRouter />`), and the site's own small module (src/scripts/site.ts:
 * theme toggle, progress, quiz, copy buttons, lesson search), which only
 * enhances pages that are already complete HTML.
 *
 * SEO for every page comes from the props: a unique `title` + `description`,
 * a canonical URL and `og:url` (when the site's address is known,
 * src/lib/site-url.ts), Open Graph + Twitter card tags, and links to the RSS
 * feed and the sitemap. Structured data (JSON-LD, src/lib/json-ld.ts): the
 * home page gets `WebSite` + `Organization`, a page passes its own in `jsonLd`.
 */
import '../styles/global.css';

import {ClientRouter} from 'astro:transitions';

import {FOOTER, NAV, SITE} from '../content/site';
import {allLessons} from '../lib/course';
import {type JsonLd, jsonLdText, siteJsonLd} from '../lib/json-ld';
import {absoluteUrl} from '../lib/site-url';

interface Props {
  /** The page's own name; the tab shows "<title> · <site>". Omit on home. */
  title?: string;
  /** The meta description (search results, social cards): ~150 characters. */
  description?: string;
  /** A social card image, 1200×630: a `/path` on this site or an https URL. */
  image?: string;
  /** Text for the social image (`og:image:alt`). */
  imageAlt?: string;
  /** `article` on a blog post or lesson (adds its dates), `website` elsewhere. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** Keep this page out of search results (and the sitemap: src/pages/sitemap.xml.ts). */
  noindex?: boolean;
  /** The page's own structured data (src/lib/json-ld.ts), e.g. `postJsonLd(…)` on a post. */
  jsonLd?: JsonLd;
}

const {
  title,
  description = SITE.description,
  image = '/og-default.png',
  imageAlt = `${SITE.name}: বাংলায় পেমেন্ট টেস্টিং কোর্স`,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: বাংলায় পেমেন্ট, API ও Webhook টেস্টিং`;
const path = Astro.url.pathname;
const canonical = noindex ? null : absoluteUrl(path);
const socialImage = image ? absoluteUrl(image) : null;
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
// The home page tells search engines the site's name; other pages bring their own.
const structured = [...(path === '/' ? [siteJsonLd()] : []), ...(jsonLd && !noindex ? [jsonLd] : [])];
// Every lesson's id: the header progress bar counts the ones done in this browser.
const lessonIds = (await allLessons()).map(lesson => lesson.id).join(',');
const year = new Intl.NumberFormat('bn-BD', {useGrouping: false}).format(new Date().getUTCFullYear());
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href="/fonts/hind-siliguri-bengali-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} ব্লগ`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {structured.map(data => <script type="application/ld+json" set:html={jsonLdText(data)} />)}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">মূল লেখায় যান</a>
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href="/" class="brand"><span class="brand-mark" aria-hidden="true">QA</span>{SITE.name}</a>
        <nav class="site-nav" aria-label="প্রধান মেনু">
          {
            NAV.map(item => (
              <a href={item.href} data-astro-prefetch="viewport" aria-current={active(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <form class="header-search" role="search" action="/lessons/" method="get">
          <label class="sr-only" for="header-q">লেসন খুঁজুন</label>
          <input id="header-q" name="q" type="search" placeholder="লেসন খুঁজুন…" autocomplete="off" />
        </form>
        <button type="button" class="icon-button" data-theme-toggle aria-label="ডার্ক মোড চালু করুন">
          <span aria-hidden="true" data-theme-icon>🌙</span>
        </button>
        <details class="menu menu-toggle-wrap">
          <summary class="icon-button" aria-label="মেনু খুলুন"><span aria-hidden="true">☰</span></summary>
          <div class="menu-panel">
            <form role="search" action="/lessons/" method="get" class="search-field">
              <label class="sr-only" for="menu-q">লেসন খুঁজুন</label>
              <input id="menu-q" name="q" type="search" placeholder="লেসন খুঁজুন…" autocomplete="off" />
            </form>
            <nav aria-label="মোবাইল মেনু">
              {
                NAV.map(item => (
                  <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                ))
              }
              <a href="/capstone/" aria-current={active('/capstone/') ? 'page' : undefined}>ক্যাপস্টোন</a>
              <a href="/career/" aria-current={active('/career/') ? 'page' : undefined}>FAQ ও ক্যারিয়ার</a>
              <a href="/about/" aria-current={active('/about/') ? 'page' : undefined}>আমাদের সম্পর্কে</a>
            </nav>
          </div>
        </details>
      </div>
      <progress class="header-progress" max="100" value="0" aria-label="কোর্সের অগ্রগতি" data-progress-total data-lessons={lessonIds}></progress>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        {
          FOOTER.map(column => (
            <nav aria-label={column.title}>
              <h2>{column.title}</h2>
              <ul>
                {column.links.map(link => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
      <div class="wrap footer-bottom small">
        <p><strong>এই সাইটের সব কনটেন্ট শিক্ষামূলক। শুধু অনুমতিপ্রাপ্ত পরিবেশে টেস্ট করুন।</strong></p>
        <p>© {year} {SITE.name} · {SITE.publisher}-এর একটি ফ্রি উদ্যোগ · <a href="/rss.xml">RSS</a></p>
      </div>
    </footer>
    <p class="sr-only" role="status" aria-live="polite" data-announce></p>

    <script>
      import {notifyPaymentOpener} from '../lib/checkout-session';
      import '../scripts/site';

      // Back from the payment provider INSIDE a Buy button's payment window: tell the page that
      // opened it (it checks the payment and goes on), then close (docs/agent/payments.md).
      document.addEventListener('astro:page-load', notifyPaymentOpener);
    </script>
  </body>
</html>
