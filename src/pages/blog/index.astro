---
/**
 * The blog list, built from the Markdown files in `src/content/blog/`.
 * Prerendered like every page: a new post goes live with the next Publish.
 * Lists every post on one page; past ~30 posts, page it with Astro's
 * `paginate()` (`/blog/2/`…), keeping this page as page 1.
 */
import PostCard from '../../components/PostCard.astro';
import Base from '../../layouts/Base.astro';
import {publishedPosts, tagHref, tagsOf} from '../../lib/posts';

const posts = await publishedPosts();
const tags = tagsOf(posts);
---

<Base title="ব্লগ" description="পেমেন্ট টেস্টিং, API আর QA ক্যারিয়ার নিয়ে নতুন লেখা, কোর্সের আপডেট আর টিপস।">
  <section class="wrap section">
    <h1>ব্লগ</h1>
    <p class="lede">কোর্সের আপডেট, টিপস আর QA ক্যারিয়ার নিয়ে লেখা।</p>
    {
      tags.length > 0 && (
        <nav aria-label="বিষয়">
          <ul class="chips">
            {tags.map(tag => (
              <li>
                <a class="chip" href={tagHref(tag.label)}>#{tag.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {
      posts.length ? (
        <div class="grid grid-3">
          {posts.map((post, i) => (
            <PostCard post={post} as="h2" eager={i < 3} />
          ))}
        </div>
      ) : (
        <p class="muted">এখনো কোনো লেখা নেই। শীঘ্রই আসছে।</p>
      )
    }
  </section>
</Base>
