---
/** Built as `404.html` at the root: the platform answers every missing path with it. */
import Base from '../layouts/Base.astro';
---

<Base title="পাতাটি পাওয়া যায়নি" noindex>
  <section class="wrap narrow section center">
    <p class="eyebrow">৪০৪ Not Found</p>
    <h1>এই পাতাটি নেই</h1>
    <p class="lede">লিংকটি পুরনো হতে পারে, বা ঠিকানায় টাইপে ভুল আছে। মজার ব্যাপার: এটাই ৪০৪ Status Code, যা লেসন ২-এ শিখবেন!</p>
    <div class="actions">
      <a class="button" href="/">হোমে ফিরে যান</a>
      <a class="button outline" href="/lessons/">সব লেসন দেখুন</a>
    </div>
  </section>
</Base>
