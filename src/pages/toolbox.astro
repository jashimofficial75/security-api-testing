---
/** One card per free tool (src/content/tools.json), grouped by category. */
import {getCollection} from 'astro:content';

import Base from '../layouts/Base.astro';
import {allLessons, bn} from '../lib/course';

const tools = await getCollection('tools');
const lessons = new Map((await allLessons()).map(lesson => [lesson.id, lesson]));
const categories = [...new Set(tools.map(tool => tool.data.category))];
---

<Base title="টুলবক্স: সব ফ্রি টুল" description="কোর্সে ব্যবহৃত প্রতিটি ফ্রি টুল: কী কাজে লাগে, অফিসিয়াল লিংক, ইনস্টল গাইড আর কোন লেসনে ব্যবহার হয়েছে। Postman থেকে Burp Suite পর্যন্ত।">
  <div class="wrap">
    <header class="page-head">
      <h1>টুলবক্স</h1>
      <p class="lede">এই কোর্সের {bn(tools.length)}টি টুলের সবই ফ্রি বা ফ্রি প্ল্যানে চলে। ডাউনলোড সবসময় অফিসিয়াল সাইট থেকে করুন, অচেনা মিরর থেকে নয়।</p>
    </header>
    {
      categories.map(category => (
        <section class="section-sm" aria-labelledby={`cat-${category}`}>
          <h2 id={`cat-${category}`}>{category}</h2>
          <div class="grid grid-3">
            {tools
              .filter(tool => tool.data.category === category)
              .map(tool => (
                <article class="card tool">
                  <h3>{tool.data.name}</h3>
                  <p>{tool.data.use}</p>
                  <p>
                    <a href={tool.data.url} target="_blank" rel="noopener noreferrer">
                      অফিসিয়াল সাইট<span class="sr-only"> ({tool.data.name}, নতুন ট্যাবে খুলবে)</span> ↗
                    </a>
                  </p>
                  {tool.data.install.length > 0 && (
                    <details class="accordion">
                      <summary>ইনস্টল গাইড</summary>
                      <ol>
                        {tool.data.install.map(step => (
                          <li>{step}</li>
                        ))}
                      </ol>
                    </details>
                  )}
                  {tool.data.lessons.length > 0 && (
                    <p class="meta">
                      যে লেসনে লাগবে:{' '}
                      {tool.data.lessons
                        .filter(id => lessons.has(id))
                        .map((id, i) => (
                          <>
                            {i > 0 && ', '}
                            <a href={`/lessons/${id}/`}>লেসন {bn(lessons.get(id)!.data.order)}</a>
                          </>
                        ))}
                    </p>
                  )}
                </article>
              ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .section-sm {
    margin-top: 2rem;
  }

  .tool {
    display: flex;
    flex-direction: column;
  }

  .tool h3 {
    margin-bottom: 0.25rem;
    font-family: var(--mono);
    font-size: 1.1rem;
  }

  .tool .accordion {
    margin-top: auto;
  }

  .tool ol {
    padding-left: 1.25rem;
  }

  .tool .accordion > :not(summary) {
    margin-inline: 0.75rem;
  }
</style>
